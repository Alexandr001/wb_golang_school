# Скопируй в .env и при необходимости поправь: cp .env.example .env
# docker-compose подхватывает .env автоматически.
#
# Значения ниже рассчитаны на локальный запуск (make run). В docker compose
# адреса зависимостей другие, поэтому POSTGRES_HOST и KAFKA_BROKERS там заданы
# явно (postgres и kafka:9092) и эти строки не используются — остальное
# подставляется из этого файла.
#
# POSTGRES_USER/POSTGRES_PASSWORD — учётка приложения. Суперюзер контейнера БД
# задаётся отдельно, через POSTGRES_SUPERUSER_PASSWORD.

# --- Приложение ---
APP_ENV=local
LOG_LEVEL=info          # debug|info|warn|error
LOG_FORMAT=json         # json|text
SHUTDOWN_TIMEOUT=15s

# --- HTTP ---
HTTP_ADDR=:8081
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_HANDLER_TIMEOUT=5s

# --- PostgreSQL ---
# Пользователь приложения (не суперюзер): создаётся init-скриптом БД.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orders_app
POSTGRES_PASSWORD=orders_app_pwd
POSTGRES_DB=orders_db
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_CONNECT_ATTEMPTS=10
POSTGRES_CONNECT_BACKOFF=1s

# Пароль суперюзера postgres — только для инициализации контейнера БД.
POSTGRES_SUPERUSER_PASSWORD=postgres

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=orders
KAFKA_GROUP_ID=orders-service
KAFKA_MIN_BYTES=1
KAFKA_MAX_BYTES=10485760
KAFKA_MAX_WAIT=500ms
KAFKA_MAX_ATTEMPTS=5
KAFKA_RETRY_BACKOFF=500ms

# --- Кэш ---
CACHE_CAPACITY=10000
CACHE_WARMUP_LIMIT=0     # 0 → использовать CACHE_CAPACITY
