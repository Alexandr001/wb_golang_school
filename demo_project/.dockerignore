# Всё, что не нужно сборщику: контекст меньше — сборка быстрее,
# а секреты в образ не попадают вовсе.

.git/
.gitignore

# Локальные артефакты сборки: бинарь всё равно собирается внутри образа.
bin/

# Секреты. .env не должен попасть в контекст даже как слой промежуточного образа.
.env

# Документация и планы: на сборку не влияют, но инвалидируют кэш при каждой правке.
*.md

# Инфраструктурные файлы — внутри образа им делать нечего.
Dockerfile
.dockerignore
docker-compose.yml
Makefile
db/

# Редакторы
.idea/
.vscode/
*.swp
